# Variables de entorno para Vex Shop Backend
# Copia este archivo a .env y completa los valores

PORT=10000

# Configuración de Aiven PostgreSQL
DB_HOST=futbolstars-futbolstars.d.aivencloud.com
DB_PORT=17167
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=tu_contraseña_aqui
DB_SSL=true

# JWT Secret (genera uno seguro)
JWT_SECRET=tu_jwt_secret_aqui

# URL del frontend (Netlify)
FRONTEND_URL=https://horarioempresarial.netlify.app

# Nota: Para Render, estas variables se configuran en el dashboard de Render
# No uses valores reales en este archivo, solo es un ejemplo